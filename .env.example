# Copy this file to .env and fill in your values
# Never commit .env to git

# AWS
S3_BUCKET=your-s3-bucket-name
AWS_PROFILE_NAME=your-aws-profile   # omit if using IAM instance roles on EMR
AWS_REGION=us-east-2

# Kafka / MSK
KAFKA_BOOTSTRAP_SERVERS=b-1.your-msk-cluster.kafka.us-east-2.amazonaws.com:9092,b-2.your-msk-cluster.kafka.us-east-2.amazonaws.com:9092
KAFKA_TOPIC=fraud-transactions

# Redshift
REDSHIFT_HOST=your-cluster.xxxx.us-east-2.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DB=frauddb
REDSHIFT_USER=fraudadmin
REDSHIFT_PASS=your-password-here

# Spark (local only — not needed on EMR)
JAVA_HOME=/path/to/java17
